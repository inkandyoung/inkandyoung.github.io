---
import '@fontsource/gloock';
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langs, locales, type Lang, type RouteKey } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  current?: RouteKey | 'home';
  alternates: Record<Lang, string>;
  /** Canonical URL when the same content is served under several interface languages. */
  canonical?: string;
  /** Link-preview image, a path under public/. */
  ogImage?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { lang, title, description, current, alternates, canonical, ogImage = `${base}/og-${lang}.jpg` } = Astro.props;
const t = useTranslations(lang);
const fullTitle = title ? `${title} | ink & young` : `ink & young | ${t('site.tagline')}`;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? t('site.description')} />
    <link rel="canonical" href={canonicalURL} />
    {langs.map((l) => <link rel="alternate" hreflang={locales[l]} href={new URL(alternates[l], Astro.site)} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? t('site.description')} />
    <meta property="og:locale" content={locales[lang].replace('-', '_')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ink & young" />
    <meta property="og:url" content={canonicalURL} />
    <!-- Share card for WhatsApp and other link previews; regenerate with `npm run og` -->
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#eef0ea" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Header lang={lang} current={current} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
