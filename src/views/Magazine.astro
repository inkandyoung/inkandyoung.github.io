---
/**
 * The issue as a digital magazine: cover, contents, then one full-screen page
 * per piece, laid out after the print edition (src/data/magazine/<lang>.json,
 * extracted from the editors' PDFs). Text is rendered exactly as it is in the
 * data files; pages rotate through four layouts, as the PDF does.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import type { Lang } from '../i18n/ui';
import { alternatesFor, useTranslations } from '../i18n/utils';
import tr from '../data/magazine/tr.json';
import bs from '../data/magazine/bs.json';
import en from '../data/magazine/en.json';

interface Props {
  lang: Lang;
}

type Piece = { page: number; category: string; title: string; poem: boolean; text: string[]; quote: string };
type Issue = {
  cover: { kicker: string; issue: string; tags: string; note: string; title: string; subtitle: string };
  contents: { title: string; note: string };
  footer: string;
  pieces: Piece[];
};

const { lang } = Astro.props;
const t = useTranslations(lang);
const issue = ({ tr, bs, en } as Record<Lang, Issue>)[lang];
const total = issue.pieces.length + 2;
const pad = (n: number) => String(n).padStart(2, '0');

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/magazine/p*.jpg', { eager: true });
const photo = (page: number) => files[`../assets/magazine/p${pad(page)}.jpg`].default;

// The print edition's four page designs, in order.
const layouts = ['hero', 'split', 'band', 'verse'] as const;
const layoutOf = (i: number) => layouts[i % layouts.length];
const id = (page: number) => `s${pad(page)}`;
---

<Base lang={lang} current="home" alternates={alternatesFor()}>
  <div class="mag" data-total={total}>
    <section class="page cover" id={id(1)} aria-labelledby="mag-title" data-page="1">
      <Image class="bg" src={photo(1)} alt="" widths={[640, 1000, 1400]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="cover-inner">
        <p class="kicker" data-reveal>{issue.cover.kicker}{issue.cover.issue && <span> · {issue.cover.issue}</span>}</p>
        <h1 id="mag-title" data-reveal>{issue.cover.title}</h1>
        <span class="rule gold" data-reveal></span>
        <p class="subtitle" data-reveal>{issue.cover.subtitle}</p>
        <a class="start" href={`#${id(2)}`} data-reveal>{t('mag.start')} <span aria-hidden="true">↓</span></a>
        <p class="note">{issue.cover.note}</p>
        <p class="tags">{issue.cover.tags}</p>
      </div>
    </section>

    <section class="page contents" id={id(2)} aria-labelledby="contents-title" data-page="2">
      <div class="inner">
        <p class="running"><b>ink &amp; young</b> / {lang.toUpperCase()}</p>
        <h2 id="contents-title" data-reveal>{issue.contents.title}</h2>
        <span class="rule red"></span>
        <ol class="toc">
          {
            issue.pieces.map((p) => (
              <li data-reveal>
                <a href={`#${id(p.page)}`}>
                  <span class="num">{pad(p.page)}</span>
                  <span class="name">{p.title}</span>
                  <span class="cat">{p.category}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="small">{issue.contents.note}</p>
      </div>
    </section>

    {
      issue.pieces.map((p, i) => {
        const layout = layoutOf(i);
        const dark = layout === 'hero' || layout === 'verse';
        return (
          <article class:list={['page', 'piece', layout]} id={id(p.page)} aria-labelledby={`${id(p.page)}-t`} data-page={p.page}>
            <div class="media" aria-hidden="true">
              <Image src={photo(p.page)} alt="" widths={[480, 800, 1200]} sizes={layout === 'split' ? '(min-width: 800px) 50vw, 100vw' : '100vw'} />
            </div>
            <header class:list={['top', { light: dark }]}>
              <p class="running">
                <span><b>ink &amp; young</b> / {lang.toUpperCase()}</span>
                <span>
                  {pad(i + 1)} / {p.category}
                </span>
              </p>
              <h2 id={`${id(p.page)}-t`} data-reveal>{p.title}</h2>
              {dark && <span class="rule gold" data-reveal />}
            </header>
            <div class="body">
              {layout === 'split' && <span class="rule ink" />}
              <div class:list={['text', { poem: p.poem }]} data-reveal>
                {p.poem ? p.text.map((line) => <span class="line">{line}</span>) : p.text.map((para) => <p>{para}</p>)}
              </div>
              {layout !== 'split' && layout !== 'band' && <span class="rule red" />}
              {p.quote && (
                <p class="quote" data-reveal>
                  {p.quote}
                </p>
              )}
            </div>
            <footer class="foot">
              <span>{issue.footer}</span>
              <span>
                {pad(p.page)} / {pad(total)}
              </span>
            </footer>
          </article>
        );
      })
    }

    <nav class="controls" aria-label={t('mag.pages')}>
      <a class="ctl" href={`#${id(2)}`} aria-label={t('mag.contents')} title={t('mag.contents')}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" stroke="currentColor" stroke-width="1.8" fill="none" /></svg>
      </a>
      <button class="ctl" type="button" data-go="-1" aria-label={t('post.prev')} title={t('post.prev')}>‹</button>
      <span class="count" aria-live="polite"><span data-current>01</span> / {pad(total)}</span>
      <button class="ctl" type="button" data-go="1" aria-label={t('post.next')} title={t('post.next')}>›</button>
      <a class="ctl share" href={`https://wa.me/?text=${encodeURIComponent(issue.cover.title + ' · ink & young')}`} data-share data-whatsapp={t('mag.whatsapp')} data-copied={t('mag.copied')} aria-label={t('mag.share')} title={t('mag.share')}>
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm12 7a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="1.7" fill="none" /></svg>
      </a>
      <span class="toast" role="status" hidden></span>
    </nav>
  </div>
</Base>

<script>
  const mag = document.querySelector<HTMLElement>('.mag');
  if (mag) {
    const pages = [...mag.querySelectorAll<HTMLElement>('.page')];
    const current = mag.querySelector<HTMLElement>('[data-current]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let at = 0;

    // Reveal elements as they come into view (CSS hides them only when JS runs).
    const reveal = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), reveal.unobserve(e.target))),
      { rootMargin: '0px 0px -8% 0px' },
    );
    mag.querySelectorAll('[data-reveal], .media').forEach((el) => reveal.observe(el));

    // The page crossing the middle of the screen is the current one.
    const watch = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          at = pages.indexOf(e.target as HTMLElement);
          current.textContent = String(at + 1).padStart(2, '0');
        }
      },
      { rootMargin: '-50% 0px -50% 0px' },
    );
    pages.forEach((p) => watch.observe(p));

    const go = (step: number) => {
      const target = pages[Math.min(Math.max(at + step, 0), pages.length - 1)];
      target.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth' });
      history.replaceState(null, '', '#' + target.id);
    };
    mag.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.go))));
    document.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey || (e.target as HTMLElement).closest('input, textarea, select')) return;
      if (e.key === 'ArrowRight') (e.preventDefault(), go(1));
      if (e.key === 'ArrowLeft') (e.preventDefault(), go(-1));
    });

    // Share the page being read: the system share sheet on phones, WhatsApp on the web otherwise.
    const share = mag.querySelector<HTMLAnchorElement>('[data-share]')!;
    const toast = mag.querySelector<HTMLElement>('.toast')!;
    share.addEventListener('click', async (e) => {
      const page = pages[at];
      const url = `${location.origin}${location.pathname}${at ? '#' + page.id : ''}`;
      const title = (page.querySelector('h1, h2')?.textContent ?? document.title).trim();
      if (navigator.share) {
        e.preventDefault();
        try {
          await navigator.share({ title, url });
        } catch {}
        return;
      }
      share.href = `https://wa.me/?text=${encodeURIComponent(`${title} · ink & young\n${url}`)}`;
      share.target = '_blank';
      share.rel = 'noopener';
      try {
        await navigator.clipboard.writeText(url);
        toast.textContent = share.dataset.copied!;
        toast.hidden = false;
        setTimeout(() => (toast.hidden = true), 2200);
      } catch {}
    });
  }
</script>

<style>
  .mag {
    --cream: #f3eee3;
    --navy: #14263a;
    --gold: #d8b06a;
    --brick: #a3402f;
    --muted: #5b6270;
    background: var(--cream);
    color: var(--navy);
  }

  .page {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    scroll-margin-top: 0;
  }
  .rule {
    display: block;
    width: 110px;
    height: 3px;
  }
  .rule.gold {
    background: var(--gold);
  }
  .rule.red {
    background: var(--brick);
    height: 2px;
  }
  .rule.ink {
    background: var(--navy);
    width: min(100%, 360px);
    height: 2px;
  }
  .running {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-family: system-ui, 'Segoe UI', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .running b {
    text-transform: none;
    letter-spacing: 0;
  }

  /* ---- Cover ---- */
  .cover {
    color: #fbf7ee;
    background: var(--navy);
    min-height: calc(100svh - 64px);
  }
  .cover :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(14 26 40 / 0.55), rgb(14 26 40 / 0.72) 55%, rgb(14 26 40 / 0.88));
  }
  .cover-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-height: inherit;
    max-width: 1120px;
    margin-inline: auto;
    padding: clamp(40px, 9vh, 110px) var(--gutter) 84px;
  }
  .kicker {
    font-family: system-ui, 'Segoe UI', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    color: var(--gold);
  }
  .cover h1 {
    font-size: clamp(3.4rem, 1.5rem + 9vw, 9rem);
    line-height: 0.95;
    margin-top: clamp(20px, 8vh, 110px);
    max-width: 10ch;
  }
  .subtitle {
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.9rem);
    line-height: 1.4;
    max-width: 30ch;
  }
  .start {
    align-self: flex-start;
    margin-top: 8px;
    padding: 14px 22px;
    border: 1px solid rgb(251 247 238 / 0.6);
    color: inherit;
    text-decoration: none;
    font-family: system-ui, 'Segoe UI', sans-serif;
    font-weight: 600;
    min-height: 48px;
  }
  .start:hover {
    background: #fbf7ee;
    color: var(--navy);
  }
  .note {
    margin-top: auto;
    font-family: system-ui, 'Segoe UI', sans-serif;
    font-size: 0.85rem;
    opacity: 0.85;
  }
  .tags {
    font-family: system-ui, 'Segoe UI', sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }

  /* ---- Contents ---- */
  .contents .inner {
    max-width: 1120px;
    margin-inline: auto;
    padding: clamp(32px, 6vh, 64px) var(--gutter) 48px;
  }
  .contents h2 {
    font-size: clamp(3rem, 1.6rem + 6vw, 6.5rem);
    margin: clamp(24px, 6vh, 64px) 0 24px;
  }
  .contents .rule.red {
    width: 100%;
    margin-bottom: 8px;
  }
  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    column-gap: clamp(32px, 6vw, 72px);
  }
  .toc a {
    display: grid;
    grid-template-columns: 2.6em 1fr;
    padding: 14px 0 12px;
    border-bottom: 1px solid rgb(20 38 58 / 0.14);
    text-decoration: none;
  }
  .num {
    grid-row: span 2;
    font-family: system-ui, 'Segoe UI', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--brick);
    padding-top: 0.35em;
  }
  .name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.6rem);
    line-height: 1.2;
  }
  .toc a:hover .name {
    text-decoration: underline;
    text-decoration-color: var(--brick);
    text-underline-offset: 0.18em;
  }
  .cat,
  .small {
    font-family: system-ui, 'Segoe UI', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .small {
    margin-top: 20px;
    text-transform: none;
    font-size: 0.85rem;
  }

  /* ---- Pieces ---- */
  .piece {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
  }
  .media {
    overflow: hidden;
  }
  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .top,
  .body,
  .foot {
    position: relative;
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .top {
    padding-top: 26px;
  }
  .top .running {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--brick);
  }
  .top.light .running {
    color: #fbf7ee;
    border-color: rgb(216 176 106 / 0.7);
  }
  .top h2 {
    font-size: clamp(2.6rem, 1.4rem + 5vw, 5.4rem);
    line-height: 1.02;
    margin-top: clamp(28px, 10vh, 120px);
    max-width: 14ch;
  }
  .top.light h2 {
    color: #fbf7ee;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.45);
  }
  .top .rule {
    margin-top: 22px;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-block: clamp(28px, 5vh, 56px);
  }
  .text {
    font-family: var(--font-text);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.6;
    max-width: 38ch;
  }
  .text.poem .line {
    display: block;
    padding-left: 1.2em;
    text-indent: -1.2em;
  }
  .quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.6rem);
    color: var(--brick);
    max-width: 34ch;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 18px 26px;
    font-family: system-ui, 'Segoe UI', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  /* hero and verse: photo across the top with the title on it */
  .hero .media,
  .verse .media {
    grid-row: 1 / 3;
    grid-column: 1;
    height: clamp(380px, 60svh, 680px);
  }
  .verse .media {
    height: clamp(400px, 64svh, 720px);
  }
  .hero .top,
  .verse .top {
    grid-row: 1 / 3;
    grid-column: 1;
    z-index: 1;
  }
  .hero .media::after,
  .verse .media::after {
    content: '';
    position: absolute;
    inset: 0;
    height: inherit;
    background: linear-gradient(180deg, rgb(14 26 40 / 0.45), rgb(14 26 40 / 0.15) 45%, rgb(14 26 40 / 0.35));
  }
  .hero .media,
  .verse .media {
    position: relative;
  }
  .verse .text {
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem);
  }

  /* split: text on the left, photo down the right half */
  .split .media {
    height: 46svh;
  }
  .split .rule.ink {
    margin-bottom: 8px;
  }

  /* band: title and text first, photo along the bottom with the quote on it */
  .band .media {
    grid-row: 3;
    position: relative;
    min-height: 44svh;
  }
  .band .top {
    grid-row: 1;
  }
  .band .body {
    grid-row: 2;
  }
  .band .quote {
    max-width: none;
    padding: 22px 26px;
    color: #fbf7ee;
    background: var(--navy);
    border-left: 4px solid var(--gold);
  }
  .band .foot {
    grid-row: 4;
  }
  .band .media + .top {
    grid-row: 1;
  }

  @media (min-width: 800px) {
    .toc {
      grid-template-columns: 1fr 1fr;
      grid-auto-flow: column;
      grid-template-rows: repeat(10, auto);
    }
    .split {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto 1fr auto;
    }
    .split .media {
      grid-column: 2;
      grid-row: 1 / -1;
      position: relative;
      height: auto;
      min-height: 100svh;
    }
    .split .media :global(img) {
      position: absolute;
      inset: 0;
    }
    .split .top,
    .split .body,
    .split .foot {
      grid-column: 1;
      max-width: 620px;
      margin-left: auto;
      margin-right: 0;
    }
    .split .top {
      grid-row: 1;
    }
    .split .body {
      grid-row: 2;
      justify-content: center;
    }
    .split .foot {
      grid-row: 3;
    }
    .split .text {
      font-size: clamp(1.1rem, 0.9rem + 0.5vw, 1.4rem);
    }
    .split .top h2 {
      font-size: clamp(2.4rem, 1rem + 3.4vw, 4.2rem);
      margin-top: clamp(24px, 6vh, 72px);
    }
  }

  /* ---- Page controls ---- */
  .controls {
    position: fixed;
    z-index: 20;
    right: max(12px, env(safe-area-inset-right));
    bottom: max(12px, env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    background: rgb(20 38 58 / 0.9);
    color: #fbf7ee;
    border-radius: 999px;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.5);
    backdrop-filter: blur(6px);
    font-family: system-ui, 'Segoe UI', sans-serif;
  }
  .ctl {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    text-decoration: none;
  }
  .ctl:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .share {
    background: #25d366;
    color: #0b2e1a;
  }
  .share:hover {
    background: #3be07a;
  }
  .count {
    min-width: 4.4em;
    text-align: center;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .toast {
    position: absolute;
    right: 0;
    bottom: calc(100% + 8px);
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--navy);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .controls :focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  /* ---- Motion ---- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .mag [data-reveal] {
      opacity: 0;
      transform: translateY(18px);
      transition:
        opacity 0.8s ease,
        transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    :global(.js) .mag [data-reveal]:global(.in) {
      opacity: 1;
      transform: none;
    }
    :global(.js) .mag .media :global(img) {
      transform: scale(1.06);
      transition: transform 1.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    :global(.js) .mag .media:global(.in) :global(img) {
      transform: none;
    }
    html:has(.mag) {
      scroll-behavior: smooth;
    }
  }
</style>
