---
import Base from '../layouts/Base.astro';
import type { Lang } from '../i18n/ui';
import { alternatesFor, categoryLabel, localPath, useTranslations } from '../i18n/utils';
import { getAuthors, getPosts, postSlug } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const authors = await getAuthors();
const posts = await getPosts();
---

<Base lang={lang} current="authors" title={t('authors.title')} description={t('authors.intro')} alternates={alternatesFor('authors')}>
  <div class="wrap">
    <header class="page-head">
      <h1>{t('authors.title')}</h1>
      <p>{t('authors.intro')}</p>
    </header>

    <ul class="people">
      {
        authors.map((author) => {
          const works = posts.filter((p) => p.data.author.id === author.id);
          return (
            <li id={author.id} tabindex="-1">
              <h2>{author.data.name}</h2>
              <p class="meta where">
                {author.data.city}
                <span>
                  {t('authors.writes')}: {author.data.writes.map((l) => t(`lang.${l}`)).join(', ')}
                </span>
              </p>
              <p class="bio" lang={author.data.bio[lang] ? undefined : 'tr'}>{author.data.bio[lang] ?? author.data.bio.tr}</p>
              {works.length > 0 && (
                <ul class="works" aria-label={t('authors.works')}>
                  {works.map((post) => (
                    <li>
                      <a href={localPath(lang, 'posts', postSlug(post))} lang={post.data.lang}>
                        {post.data.title}
                      </a>
                      <span class="meta">
                        {categoryLabel(post.data.category, lang)}, {t('issue.label', { n: post.data.issue })}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</Base>

<style>
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .people > li {
    padding-block: 32px;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: 24px;
  }
  .people > li:target h2 {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
  .people > li:focus {
    outline: none;
  }
  h2 {
    font-size: var(--step-3);
    margin-bottom: 6px;
  }
  .where {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
    margin-bottom: 12px;
  }
  .where span {
    font-style: italic;
  }
  .bio {
    max-width: 34em;
    line-height: 1.55;
  }
  .works {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .works li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
  }
  .works a {
    font-family: var(--font-display);
    font-size: var(--step-1);
    text-decoration-color: var(--rule-strong);
  }
  .works a:hover {
    text-decoration-color: var(--red);
  }

  @media (min-width: 760px) {
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(32px, 5vw, 72px);
    }
    .people > li {
      border-bottom: 0;
      border-top: 1px solid var(--rule-strong);
    }
  }
</style>
