---
/** An issue's table of contents, set like the contents page of the printed magazine. */
import type { Lang } from '../i18n/ui';
import { categoryLabel, localPath } from '../i18n/utils';
import { postSlug, type Author, type Post } from '../lib/content';

interface Props {
  lang: Lang;
  posts: Post[];
  authors: Map<string, Author>;
}

const { lang, posts, authors } = Astro.props;
---

<ol class="contents">
  {
    posts.map((post) => (
      <li>
        <a href={localPath(lang, 'posts', postSlug(post))}>
          <span class="title" lang={post.data.lang}>{post.data.title}</span>
          <span class="by">
            {categoryLabel(post.data.category, lang)}, {authors.get(post.data.author.id)?.data.name}
          </span>
          {post.data.page && <span class="page">{post.data.page}</span>}
        </a>
      </li>
    ))
  }
</ol>

<style>
  .contents {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }
  li {
    border-bottom: 1px solid var(--rule);
  }
  a {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 16px;
    padding: 12px 0 13px;
    text-decoration: none;
  }
  .title {
    font-size: var(--step-1);
    line-height: 1.3;
  }
  a:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-underline-offset: 0.2em;
  }
  .by {
    grid-column: 1;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--ink-soft);
  }
  .page {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--red);
    font-variant-numeric: lining-nums;
  }
</style>
