---
import { site } from '../site.config';
import type { Lang } from '../i18n/ui';
import { localPath, useTranslations } from '../i18n/utils';
import { getCurrentIssue } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const issue = await getCurrentIssue();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <p class="logo">ink &amp; young</p>
      <p>{t('site.tagline')}</p>
    </div>
    <nav aria-label="ink &amp; young">
      <ul>
        <li><a href={localPath(lang, 'posts')}>{t('nav.posts')}</a></li>
        <li><a href={localPath(lang, 'authors')}>{t('nav.authors')}</a></li>
        <li><a href={localPath(lang, 'about')}>{t('nav.about')}</a></li>
        <li><a href={localPath(lang, 'contribute')}>{t('nav.contribute')}</a></li>
      </ul>
    </nav>
    <div>
      <p class="meta">{t('footer.issue')}</p>
      <p><a href={localPath(lang)}>{t('issue.label', { n: issue.data.number })}, {issue.data.title[lang]}</a></p>
      <p class="mail"><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
    </div>
  </div>
  <div class="wrap small">
    <p>© {year} ink &amp; young. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(64px, 10vw, 128px);
    border-top: 1px solid var(--rule-strong);
    padding-block: 40px 24px;
    font-size: var(--step--1);
  }
  .grid {
    display: grid;
    gap: 28px;
  }
  .logo {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
    margin-bottom: 8px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
  ul a {
    display: inline-block;
    padding-block: 10px;
  }
  .mail {
    margin-top: 8px;
  }
  .small {
    margin-top: 32px;
    color: var(--ink-soft);
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
    ul {
      flex-direction: column;
      gap: 0;
    }
    ul a {
      padding-block: 4px;
    }
  }
</style>
