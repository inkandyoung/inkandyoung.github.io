---
// "/" sends visitors to their browser language when we publish in it, Turkish otherwise.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ink &amp; young</title>
    <meta http-equiv="refresh" content={`0; url=${base}/tr/`} />
    <link rel="canonical" href={`${base}/tr/`} />
    <script is:inline define:vars={{ base }}>
      var supported = ['tr', 'bs', 'en'];
      var prefs = navigator.languages || [navigator.language];
      var pick = 'tr';
      for (var i = 0; i < prefs.length; i++) {
        var code = String(prefs[i]).slice(0, 2).toLowerCase();
        if (code === 'hr' || code === 'sr') code = 'bs';
        if (supported.indexOf(code) !== -1) { pick = code; break; }
      }
      location.replace(base + '/' + pick + '/');
    </script>
  </head>
  <body>
    <a href={`${base}/tr/`}>Türkçe</a> / <a href={`${base}/bs/`}>Bosanski</a> / <a href={`${base}/en/`}>English</a>
  </body>
</html>
