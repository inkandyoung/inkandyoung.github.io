---
import Base from '../layouts/Base.astro';
import { langs } from '../i18n/ui';
import { alternatesFor, localPath, useTranslations } from '../i18n/utils';

// One page for every language: the message is short enough to show all three.
const lang = 'tr';
---

<Base lang={lang} title="404" alternates={alternatesFor()}>
  <div class="wrap notfound">
    <p class="code">404</p>
    {
      langs.map((l) => {
        const t = useTranslations(l);
        return (
          <section lang={l}>
            <h1>{t('notfound.title')}</h1>
            <p>
              {t('notfound.text')} <a href={localPath(l)}>{t('nav.home')}</a>
            </p>
          </section>
        );
      })
    }
  </div>
</Base>

<style>
  .notfound {
    padding-block: clamp(48px, 8vw, 112px) 0;
    display: grid;
    gap: 28px;
  }
  .code {
    font-family: var(--font-display);
    font-size: var(--step-5);
    color: var(--red);
    line-height: 1;
  }
  section {
    max-width: 34em;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }
  h1 {
    font-size: var(--step-3);
    margin-bottom: 8px;
  }
</style>
